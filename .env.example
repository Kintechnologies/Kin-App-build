# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Web Search (Tavily — free tier at tavily.com)
TAVILY_API_KEY=your-tavily-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Google Calendar (console.cloud.google.com > APIs > Calendar API)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_WEBHOOK_SECRET=your-google-webhook-secret

# RevenueCat (revenuecat.com > Project Settings > Webhooks)
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Cron (generate a random secret, e.g. openssl rand -hex 32)
CRON_SECRET=your-cron-secret

# Upstash Redis — rate limiting (upstash.com > Create Database > REST API)
# Optional: if absent, rate limiting is disabled (safe for local dev and CI)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Founder activity alerts (optional — if RESEND_API_KEY is unset, alerts only
# land in the activity_log table, no email is sent)
RESEND_API_KEY=your-resend-api-key
ACTIVITY_ALERT_EMAIL=austin.ford1519@gmail.com
ACTIVITY_ALERT_FROM=Kin Activity <noreply@kinai.family>

# Twilio (SMS — phone OTP, briefings, conversational replies)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
