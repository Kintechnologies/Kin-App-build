# ─────────────────────────────────────────────────────────────────────────────
# Kin AI — environment configuration template
# Copy to .env.local and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public values are exposed to the browser; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional alias — used by seed_demo.py when NEXT_PUBLIC_SUPABASE_URL isn't set
SUPABASE_URL=your-supabase-url

# ── Anthropic (Claude API) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Twilio (SMS — inbound webhook + outbound briefings) ──────────────────────
# Account SID + auth token at console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# A2P 10DLC Messaging Service SID (console.twilio.com > Messaging > Services),
# starts with MG. Outbound briefings/SMS are sent through this service so
# carrier delivery is tied to the registered A2P campaign — sending from a
# bare long code fails US carrier filtering with error 30034.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Verify Service SID (console.twilio.com > Verify > Services), starts
# with VA. Used by Supabase phone-OTP auth. Verify has its own Twilio-managed
# sender pool, separate from TWILIO_PHONE_NUMBER above (which sends briefings),
# so a STOP opt-out on an OTP code never disables briefings. Configure the same
# value in the Supabase dashboard (Authentication > Providers > Phone); this
# var is only consumed by local `supabase start` via config.toml.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ───────────────────────────────────────────────────────────────────
# Create the "Kin Premium" product, then copy the monthly + annual price IDs.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_MONTHLY_PRICE_ID=price_monthly_xxx
STRIPE_ANNUAL_PRICE_ID=price_annual_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# ── Google Calendar (console.cloud.google.com > APIs > Calendar API) ─────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_WEBHOOK_SECRET=your-google-webhook-secret

# ── Google Maps (commute "leave by" line in morning briefing) ────────────────
# Optional: if absent, commute insights are skipped
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── OpenWeather (weather line in morning briefing — openweathermap.org) ──────
# Optional: if absent, briefings are generated without weather
OPENWEATHER_API_KEY=your-openweather-api-key

# ── Web Search (Tavily — free tier at tavily.com) ────────────────────────────
# Optional: if absent, the chat web_search tool is disabled
TAVILY_API_KEY=your-tavily-api-key

# ── Cron (generate a random secret, e.g. openssl rand -hex 32) ───────────────
CRON_SECRET=your-cron-secret

# ── Upstash Redis — rate limiting (upstash.com > Create Database > REST API) ─
# Optional: if absent, rate limiting is disabled (safe for local dev and CI)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ── Sentry (error monitoring — sentry.io > Project Settings > Client Keys) ───
# Optional: if absent, errors are not reported externally
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ── Resend (transactional email + founder activity alerts) ──────────────────
# resend.com > API Keys. The kinai.family domain must be verified in Resend.
# Optional: if absent, welcome + partner-invite emails are skipped, and activity
# events still land in activity_log without an alert email.
RESEND_API_KEY=your-resend-api-key
# Sender for transactional email (welcome, partner invite). Verified domain.
RESEND_FROM=Kin <kin@kinai.family>
ACTIVITY_ALERT_EMAIL=austin.ford1519@gmail.com
ACTIVITY_ALERT_FROM=Kin Activity <noreply@kinai.family>

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Mobile (Expo) — apps/mobile/.env or EAS secrets
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
