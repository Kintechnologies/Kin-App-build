{
  "name": "kin-monorepo",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @kin/web",
    "build:web": "npm run build -w @kin/web",
    "gen:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > packages/shared/src/database.types.ts",
    "test": "npm run test -w @kin/shared && npm run test -w @kin/web",
    "test:watch": "npm run test:watch -w @kin/web",
    "test:shared": "npm run test -w @kin/shared",
    "test:web": "npm run test -w @kin/web"
  },
  "devDependencies": {
    "vitest": "latest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0"
  }
}
